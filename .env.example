# ─── Application Runtime ────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=2.0.0

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=spyder
POSTGRES_USER=spyder
POSTGRES_PASSWORD=spyder_secret_change_me

DATABASE_URL=postgresql://spyder:spyder_secret_change_me@localhost:5432/spyder

# ─── Redis & Celery Workers ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=true

# ─── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=spyder_neo4j_change_me

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=spyder_minio
MINIO_SECRET_KEY=spyder_minio_secret_change_me
MINIO_SECURE=false
MINIO_BUCKET=evidence

# ─── Auth & Cryptographic Audit Signing ─────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret_key_at_least_32_chars
AUDIT_SIGNING_KEY=CHANGE_ME_to_a_separate_32_char_audit_hmac_signing_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_BODY_REFRESH=true

# ─── Uploads & CORS ─────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_SHOW_DEMO_HINT=true
