# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=spyder
POSTGRES_USER=spyder
POSTGRES_PASSWORD=spyder_secret_change_me

DATABASE_URL=postgresql://spyder:spyder_secret_change_me@localhost:5432/spyder

# ─── Neo4j ──────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=spyder_neo4j_change_me

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=spyder_minio
MINIO_SECRET_KEY=spyder_minio_secret_change_me
MINIO_SECURE=false
MINIO_BUCKET=evidence

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_to_a_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
